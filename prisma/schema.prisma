generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum JobType {
  RESTORE
  ANIMATE
}

// FREE = vista previa gratuita (modelo barato, baja resolución, marca de agua)
// PAID = resultado de pago (modelo caro, resolución completa)
enum JobTier {
  FREE
  PAID
}

// Un job RESTORE pasa RESTORING → DONE.
// Un job ANIMATE encadena dos llamadas a fal: RESTORING → ANIMATING → DONE.
enum JobStage {
  RESTORING
  ANIMATING
  DONE
}

enum CreditReason {
  RESTORE
  ANIMATE
  FREE_PREVIEW
  PURCHASE
  REFUND
}

model User {
  // @default(cuid()) es una red de seguridad: Auth.js genera el id él mismo
  // antes de llamar a adapter.createUser (así que este default normalmente
  // nunca se usa), pero si eso cambiara entre versiones, un create sin id
  // explícito falla con un error críptico en vez de tener un fallback.
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  isAnonymous   Boolean   @default(true)

  credits   Int      @default(0)
  freeUsed  Boolean  @default(false)
  createdAt DateTime @default(now())

  accounts     Account[]
  sessions     Session[]
  jobs         Job[]
  transactions CreditTransaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Rate limiting por ventana fija, sin dependencias nuevas: ya tenemos
// Postgres, así que no hace falta Redis/Upstash para el volumen de tráfico
// de este producto (ver AGENTS.md para el trade-off). `key` codifica el
// recurso + identificador ("jobs:ip:1.2.3.4", "jobs:user:<id>",
// "auth:email:x@y.com"); windowStart es el inicio de la ventana redondeado
// hacia abajo. El upsert es atómico: dos requests simultáneas nunca pisan
// el conteo una de la otra.
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

// Segunda capa antiabuso del free tier, además de User.freeUsed: el id es un
// hash (canvas + características del navegador) que el cliente calcula y
// envía. No sobrevive a un cambio de navegador, pero sí a incógnito/borrar
// cookies dentro del mismo navegador — que es el caso de abuso más común.
model DeviceFingerprint {
  id        String   @id
  freeUsed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       JobStatus @default(PENDING)
  type         JobType
  tier         JobTier
  stage        JobStage  @default(RESTORING)
  inputUrl     String
  outputUrl    String?
  restoredUrl  String? // salida intermedia de la restauración; entrada del video en jobs ANIMATE
  watermarked  Boolean   @default(false)
  falRequestId String?   @unique // correlaciona el webhook de fal; se reescribe en cada salto de etapa
  deviceFingerprint String? // fingerprint que reclamó la restauración gratis, si aplica — permite revertirla si el job falla
  error        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactions CreditTransaction[]

  @@index([userId])
  @@index([createdAt])
}

model CreditTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int // negativo al consumir, positivo al comprar/reembolsar
  reason    CreditReason
  jobId     String?
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
}
